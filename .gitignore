!data/literature/query_log.json
runs/.current
data/literature/pubtator/
data/literature/extraction_batches/
data/literature/extracted/
!data/raw/spatial/*/
data/raw/spatial/*/*
!data/raw/spatial/*/manifest.json
runs/*/report.html
