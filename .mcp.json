{
  "mcpServers": {
    "expression-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "python",
        "-m",
        "ucatlas.mcp_servers.expression"
      ],
      "env": {
        "ATLAS_RUN_DIR": "${ATLAS_RUN_DIR:-}"
      }
    },
    "kg-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "python",
        "-m",
        "ucatlas.mcp_servers.kg"
      ],
      "env": {
        "ATLAS_RUN_DIR": "${ATLAS_RUN_DIR:-}"
      }
    },
    "external-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "python",
        "-m",
        "ucatlas.mcp_servers.external"
      ],
      "env": {
        "ATLAS_RUN_DIR": "${ATLAS_RUN_DIR:-}"
      }
    },
    "cell-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "python",
        "-m",
        "ucatlas.mcp_servers.cell"
      ],
      "env": {
        "ATLAS_RUN_DIR": "${ATLAS_RUN_DIR:-}"
      }
    }
  }
}
