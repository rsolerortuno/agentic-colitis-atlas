{#- "?" button: the help text lives in data attributes, the page script builds the panel on click. -#}
{% macro q(key) -%}
{%- set h = H.get(key) -%}
{%- if h -%}<button class="q" type="button" aria-expanded="false" aria-label="What is this?" data-what="{{ h.what | e }}" data-read="{{ h.read | e }}" data-watch="{{ h.watch | e }}">?</button>{%- endif -%}
{%- endmacro %}

{% macro plot(key, html) -%}
{%- if html -%}<div class="plot" data-key="{{ key }}"><div class="plot-q">{{ q(key) }}</div>{{ html | safe }}</div>{%- endif -%}
{%- endmacro %}

{% macro plain(key) -%}
{%- if PLAIN.get(key) -%}<div class="plainbox"><b>In plain words.</b> {{ PLAIN[key] }}</div>{%- endif -%}
{%- endmacro %}

{% macro paras(list) -%}
{% for p in list %}<p class="claim" data-evidence="{{ p.evidence_ids | evattr }}">{{ p | statement_html | safe }} {{ p.evidence_ids | cite | safe }}</p>
{% endfor %}
{%- endmacro %}

{% macro findings(name, title) -%}
{% if f.agent_findings[name] %}<h3>{{ title }} (verified)</h3>
{% for x in f.agent_findings[name].findings %}
<p class="claim" data-evidence="{{ x.evidence_ids | evattr }}"><strong>{{ x.gene }}</strong> <span class="tag">{{ (x.role or x.layer or "") | replace("_"," ") }}</span> {{ x | statement_html | safe }} {{ x.evidence_ids | cite | safe }}</p>
{% endfor %}{% endif %}
{%- endmacro %}
