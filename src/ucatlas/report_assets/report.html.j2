{% from "macros.j2" import q, plot, plain, paras, findings with context %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ulcerative Colitis Atlas</title>
<style>
{{ css | safe }}
.tag.epithelial{background:var(--s1);color:#fff}.tag.stromal{background:var(--s2);color:#fff}.tag.immune{background:var(--s3);color:#fff}
details.howbox summary{cursor:pointer}
</style>
<script data-asset="plotly.min.js">{{ plotly_js | safe }}</script>
<script data-asset="cytoscape.min.js">{{ cytoscape_js | safe }}</script>
<script>
// inline payload, or (published site) a file fetched on first use: scripts/split_site.py
window.atlasPayload=async function(id){var el=document.getElementById(id);var src=el.getAttribute('data-src');var t=src?await (await fetch(src)).text():el.textContent;var packed=Uint8Array.from(atob(t.trim()),function(c){return c.charCodeAt(0);});return JSON.parse(await new Response(new Blob([packed]).stream().pipeThrough(new DecompressionStream('gzip'))).text());};
</script>
</head>
<body>
<div class="top"><div class="wrap">
  <div class="brand"><h1>Ulcerative Colitis Atlas</h1>
    <span class="sub">{{ f.disease.name }} · agentic multi-omics GraphRAG · generated {{ f.generated_utc[:10] }} · config <code>{{ f.config_sha256[:8] }}</code></span></div>
  <nav class="nav" aria-label="Sections">
    <button class="navbtn" type="button" id="navbtn" aria-expanded="false" aria-controls="navmenu">
      <span class="lbl">&#9776; Sections</span><span class="crumb" id="navcrumb"></span><span class="caret">&#9662;</span></button>
    <button class="navstep" type="button" id="navprev" aria-label="Previous section">&#8592;</button>
    <button class="navstep" type="button" id="navnext" aria-label="Next section">&#8594;</button>
    <div class="navmenu" id="navmenu" hidden>
    {% for cat, subs in nav %}<div class="navcat"><h4>{{ cat }}</h4>
      {% for sub, keys in subs %}<div class="navsub"><span>{{ sub }}</span>
        {% for k in keys %}<button class="tab" type="button" data-tab="{{ k }}" data-cat="{{ cat }}">{{ nav_text[k][0] }}{% if k == 'discovery' %}<span class="n">{{ kpis.fic }}</span>{% endif %}<small>{{ nav_text[k][1] }}</small></button>{% endfor %}
      </div>{% endfor %}
    </div>{% endfor %}
    </div>
  </nav>
</div></div>

<main class="wrap">

<!-- ================================================================ OVERVIEW -->
<section class="panel" id="tab-overview" data-name="overview">
{% include "overview_intro.html.j2" %}
<div class="kpis">
  <div class="kpi">{{ q("kpi_cohorts") }}<b>8</b><span>biopsy cohorts ({{ "{:,}".format(kpis.samples) }} samples)</span></div>
  <div class="kpi">{{ q("kpi_universe") }}<b>{{ "{:,}".format(kpis.universe) }}</b><span>genes scored</span></div>
  <div class="kpi">{{ q("kpi_claims") }}<b>{{ "{:,}".format(kpis.claims) }}</b><span>evidence-backed claims in the graph</span></div>
  <div class="kpi">{{ q("kpi_cells") }}<b>{{ "{:,}".format(kpis.cells) }}</b><span>single cells in four scRNA-seq atlases</span></div>
  <div class="kpi">{{ q("kpi_spots") }}<b>{{ "{:,}".format(kpis.spots) }}</b><span>Visium spots and {{ "{:,}".format(kpis.xenium_cells) }} Xenium cells</span></div>
  <div class="kpi">{{ q("kpi_mr") }}<b>{{ "{:,}".format(kpis.mr_genes) }}</b><span>genes tested for a causal effect (MR)</span></div>
  <div class="kpi">{{ q("kpi_proteins") }}<b>{{ kpis.proteins }}</b><span>AlphaFold models analysed</span></div>
  <div class="kpi">{{ q("kpi_fic") }}<b>{{ kpis.fic }}</b><span>first-in-class opportunities (of {{ kpis.pool }} screened)</span></div>
</div>
<h2>Summary of the findings</h2>
<p class="small">Written by the orchestrating agent from the six agent reports. Every sentence cites evidence records and passed the automatic checks.</p>
{{ paras(f.narrative.summary) }}
<h2>Prioritised candidates</h2>
<p class="small">The orchestrator picked these from the numeric ranking and the verified agent reports. It may depart from the ranking and then says why. The tags show the role (target, biomarker or both), the convergence rank, the cell that makes the gene in inflamed mucosa, the causal genetic estimate where one exists and any drug that already reached the clinic.</p>
<div class="grid">
{% for t in f.targets %}{% set b = badges.get(t.gene, {}) %}
<div class="card cand claim" data-evidence="{{ t.evidence_ids | evattr }}">
  <h3>{{ loop.index }}. {{ t.gene }}</h3>
  <div class="meta">
    <span class="tag {{ {'target':'t','biomarker':'b','target_and_biomarker':'tb'}.get(t.category,'') }}">{{ t.category | replace("_"," ") }}</span>
    {% if b.rank %}<span class="tag">rank {{ b.rank }}</span>{% endif %}
    {% if b.cell_label %}<span class="tag">{{ b.cell_label }}{% if b.cell_share is not none %} {{ "%.0f" | format(b.cell_share * 100) }}%{% endif %}</span>{% endif %}
    {% if b.verdict %}<span class="tag{% if b.verdict == 'composition' %} warn{% endif %}">{{ b.verdict | replace("_"," ") }}</span>{% endif %}
    {% if b.mr %}<span class="tag">{{ b.mr }}</span>{% endif %}
    {% if b.drug %}<span class="tag fic">{{ b.drug }}</span>{% endif %}
  </div>
  <p>{{ t | statement_html | safe }} {{ t.evidence_ids | cite | safe }}</p>
</div>
{% endfor %}
</div>
</section>

<!-- ================================================================ CANDIDATES -->
<section class="panel" id="tab-candidates" data-name="candidates">
{% include "candidate_evidence.html.j2" %}
{{ plain('candidates') }}
<h2>The convergence ranking</h2>
<p class="lede">Each gene gets one score built from six kinds of evidence: how much it changes in UC biopsies (pooled over eight cohorts), in how many cohorts the change repeats, whether it differs between inflamed and non-inflamed mucosa of the same patient, human genetics, the literature and whether a drug exists or looks possible. Every kind is scaled from 0 to 1 and multiplied by a weight ({% for k, v in sw.items() %}{{ k }} {{ v }}{% if not loop.last %}, {% endif %}{% endfor %}). The weights live in <code>config.yaml</code> and were set before the results were known. {{ "{:,}".format(f.convergence.universe_size) }} genes are scored.</p>
<div class="grid two">
  {{ plot('stream_stack', figs.stream_stack) }}
  {{ plot('component_heatmap', figs.component_heatmap) }}
</div>
<h3 id="top25">Top 25 {{ q('top25') }}</h3>
<p class="small">This ranking scores how many kinds of evidence agree, so its top is mostly well-known UC biology: the neutrophil chemokine axis, matrix metalloproteinases, calprotectin (S100A8/A9) and the lost epithelial programme. That is its check, not its news. It mixes three kinds of gene: changes of resident tissue, markers of arriving immune cells, and genes lost in UC; the "How to read it" column says which, from the data. New targets are in Discovery, the Validation shortlist and Repurposing.</p>
<div class="tw"><table class="t25">
<thead><tr><th>#</th><th>Gene</th><th>Score</th>{% for k in sw %}<th>{{ k[:6] }}.</th>{% endfor %}<th>Rank 90 % interval</th>
<th>Meta log2FC</th><th>Cohorts</th><th>Local log2FC (paired)</th><th>How to read it</th><th>Drugs: in UC or elsewhere?</th><th>Evidence</th></tr></thead>
<tbody>
{% for r in top25 %}{% set ids = [] %}{% for v in r.evidence_ids.values() %}{% for i in v %}{% set _ = ids.append(i) %}{% endfor %}{% endfor %}
<tr class="claim" data-evidence="{{ ids | evattr }}">
<td>{{ r.rank }}</td><td><strong>{{ r.gene }}</strong></td>
<td class="num"><span class="score" style="width:{{ (r.score * 5) | round(0) | int }}px"></span>{{ "%.2f" | format(r.score) }}</td>
{% for k in sw %}<td class="num">{{ r.components[k] }}</td>{% endfor %}
<td class="num">{% if r.rank_interval_90 %}{{ r.rank_interval_90.rank_p05 }}–{{ r.rank_interval_90.rank_p95 }}{% else %}—{% endif %}</td>
<td class="num">{{ r.meta_log2fc | fmt }}</td><td class="num">{{ r.cohorts_same_direction | fmt }}/8</td><td class="num">{{ r.paired_log2fc | fmt }}</td>
<td class="wrap">{{ top_reading.get(r.gene, "") }}</td>
{% set di = drugind.get(r.gene) %}<td class="wrap">{% if di %}{{ di.text }} {{ [di.evidence_id] | cite | safe }}{% else %}no clinical drug{% endif %}</td>
<td class="cites">{{ ids[:3] | cite | safe }}</td></tr>
{% endfor %}
</tbody></table></div>
<div class="howbox calc"><h4>How each column is calculated</h4>
<p class="small" style="margin-top:0">Every evidence stream is turned into a number from 0 (no evidence) to 1 (strongest). The score is the sum of these numbers, each multiplied by its weight, so the largest possible score is {{ sw.values() | sum }}.</p>
<div class="tw"><table><thead><tr><th>Column</th><th>What it measures</th><th>How it is calculated</th></tr></thead><tbody>
<tr><td>Score</td><td>Overall strength of agreement</td><td>Sum over the six streams of weight × component.</td></tr>
<tr><td>expres.</td><td>Change in UC biopsies</td><td>min(1, |pooled log2 fold change| ÷ 3) when the random-effects meta-analysis over the cohorts that measured the gene has an adjusted p below 0.05 (at least two cohorts).</td></tr>
<tr><td>replic.</td><td>Repeats across cohorts</td><td>Share of the eight cohorts with a significant change in the same direction as the pooled estimate.</td></tr>
<tr><td>inflam.</td><td>Local inflammation</td><td>min(1, |log2 fold change| ÷ 2) for inflamed against non-inflamed biopsies of the same MSCCR patients, when significant.</td></tr>
<tr><td>geneti.</td><td>Human genetics</td><td>Open Targets germline genetic association score for UC.</td></tr>
<tr><td>litera.</td><td>What the literature says</td><td>The larger of the checked PubMed relations ÷ 3 (up to 1) and the Open Targets literature score.</td></tr>
<tr><td>tracta.</td><td>Druggability</td><td>1 if a drug for the gene reached the clinic (any disease), 0.5 if it looks tractable by a small molecule or antibody, 0 otherwise.</td></tr>
<tr><td>Rank 90 % interval</td><td>How stable the rank is</td><td>5th to 95th percentile of the gene's rank over 1,000 random changes to the weights.</td></tr>
<tr><td>Meta log2FC</td><td>Raw change</td><td>Pooled UC minus control on a log2 scale. +1 is twice as high.</td></tr>
<tr><td>Cohorts</td><td>Agreement</td><td>Cohorts whose change has the same sign as the pooled change.</td></tr>
<tr><td>Local log2FC (paired)</td><td>Local change</td><td>Paired log2 fold change in MSCCR.</td></tr>
<tr><td>How to read it</td><td>What kind of gene</td><td>From the data: lost in UC (pooled change below zero); made mainly by neutrophils (over half its inflamed-mucosa RNA in Gubatan 2026); rise explained by arriving immune cells (composition verdict); immune brake (checkpoint, blocking it causes colitis); otherwise a change in resident tissue, with whether drugs exist in UC or for other diseases.</td></tr>
<tr><td>Drugs: in UC or elsewhere?</td><td>Existing drugs and where they are</td><td>Up to three drugs aimed at the gene, at their most advanced clinical stage: in UC; else in Crohn's disease or IBD; else for other diseases ("repurposing": reachable, partly known safety, never tried in UC). Drugs that hit more than five targets are set apart as broad drugs. Open Targets clinical precedence; an approval known only from an ATC code is shown as not confirmed.</td></tr>
</tbody></table></div></div>
{% if f.narrative.sections.integration %}<h3 style="margin-top:1.6em">Integration</h3>{% endif %}
{{ paras(f.narrative.sections.integration or []) }}
</section>

<!-- ================================================================ EXPRESSION -->
<section class="panel" id="tab-expression" data-name="expression">
{{ plain('expression') }}
<h2>What changes in ulcerative colitis</h2>
{{ paras(f.narrative.sections.expression or []) }}
<div class="grid two">
  {{ plot('volcano_ic', figs.volcano_ic) }}{{ plot('volcano_paired', figs.volcano_paired) }}
  {{ plot('cohort_agree', figs.cohort_agree) }}{{ plot('replication', figs.replication) }}
</div>
<h3>Association with disease activity {{ q('activity') }}</h3>
<p class="small">This shows how closely each gene follows the endoscopic Mayo subscore (0 normal to 3 severe) across the UC biopsies of MSCCR and of the Leuven vedolizumab cohort. Disease activity is the outcome-like measure available in biopsy cohorts; response to treatment is on the Treatment tab.</p>
{{ plot('activity', figs.activity) }}
<div class="howbox"><h4>How to read this chart</h4><ul>
<li>Each gene has up to two bars: blue for MSCCR and orange for the Leuven cohort. The genes shown are the report candidates and the top of the convergence ranking.</li>
<li>The horizontal axis is the Spearman correlation between the gene and the Mayo subscore, from -0.7 to +0.7.</li>
<li>A bar to the right means the gene is higher in more active disease. A bar to the left means it is lower: usually a gene of the healthy lining that is lost as inflammation grows.</li>
<li>When both cohorts point the same way, the link is more believable.</li></ul>
<p class="small" style="margin:.5em 0 0">Strongest in MSCCR, higher with activity: {% for g, r in activity_caption.up %}{{ g }} ({{ r }}){% if not loop.last %}, {% endif %}{% endfor %}; lower with activity: {% for g, r in activity_caption.down %}{{ g }} ({{ r }}){% if not loop.last %}, {% endif %}{% endfor %}.</p></div>
{% if third.adjusted %}{% set Ad = third.adjusted %}
<h3>Does the change survive age, sex and colon segment?</h3>
<p class="small">In MSCCR, control biopsies are older (median 56 vs 44 years) and come mostly from the rectum and caecum, inflamed biopsies more often from the sigmoid and left colon. The inflamed-vs-control change was re-estimated on {{ Ad.biopsies }} biopsies of {{ Ad.patients }} patients with colon segment, age and sex as covariates (standard errors clustered by patient). The adjusted and unadjusted changes correlate at rho {{ Ad.spearman_adjusted_vs_unadjusted }}, and {{ Ad.changes_holding }} of {{ Ad.changes_tested }} clear changes ({{ "%.0f" | format(100 * Ad.share_holding) }} %) hold: same sign, at least half the size, padj &lt; 0.05.</p>
<div class="tw"><table><thead><tr><th>Gene</th><th class="num">Unadjusted log2FC</th><th class="num">Adjusted log2FC</th><th class="num">Adjusted padj</th><th>Holds</th></tr></thead><tbody>
{% for r in third.adjusted_rows %}<tr><td><strong>{{ r.gene }}</strong></td><td class="num">{{ r.un | fmt }}</td><td class="num">{{ r.adj | fmt }}</td><td class="num">{{ r.padj }}</td><td>{{ "yes" if r.holds else "no" }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
<h2>Local inflammation or disease-wide?</h2>
{{ paras(f.narrative.sections.inflammation or []) }}
<h2>Replication across cohorts {{ q('replication_table') }}</h2>
{{ paras(f.narrative.sections.replication or []) }}
{% if replication %}<div class="tw"><table><thead><tr><th>Cohort</th><th class="num">Discovery changes tested</th><th class="num">Same direction, significant</th><th class="num">Share</th><th class="num">Spearman rho</th></tr></thead><tbody>
{% for r in replication %}<tr><td>{{ cohort_names.get(r.cohort, r.cohort) }}</td><td class="num">{{ r.tested }}</td><td class="num">{{ r.replicated_same_direction }}</td><td class="num">{{ "%.0f" | format(100 * r.share) }} %</td><td class="num">{{ "%.2f" | format(r.rho) }}</td></tr>
{% endfor %}</tbody></table></div>{% endif %}
{{ findings('expression', 'Expression agent findings') }}
</section>

<!-- ================================================================ CELLS -->
<section class="panel" id="tab-cells" data-name="cells">
{{ plain('cells') }}
<h2>Which cells make each candidate?</h2>
<p class="lede">The cell-type calls come from the colon single-cell atlas of Gubatan et al. 2026 ({{ "{:,}".format(cell.sc3_cells) }} cells from inflamed and non-inflamed UC mucosa), the only one that captures neutrophils. "Share of transcripts" is the part of a gene's RNA in inflamed mucosa that each cell family makes. It separates a gene the lining or the stroma makes from one that arrives with infiltrating cells. The composition adjustment then asks the same question in the bulk biopsies: how much of the UC change is left once the mix of cell types is accounted for. The last blocks repeat the attribution in three more single-cell atlases and in the tissue.</p>
{{ paras(f.narrative.sections.cells or []) }}
<div class="grid two">
  {{ plot('dotplot', figs.dotplot) }}{{ plot('share_stack', figs.share_stack) }}
</div>
{{ plot('neutrophil_retained', figs.neutrophil_retained) }}
<h3>Cell type of each candidate {{ q('cell_table') }}</h3>
<div class="tw" style="margin-top:14px"><table>
<thead><tr><th>Gene</th><th>Highest-expressing cell type (mean)</th><th>% cells</th><th>Share of transcripts (top family)</th><th>Neutrophil share</th><th>τ</th>
<th>Change kept after composition</th><th>Inflamed vs healthy, same cell type</th><th>Evidence</th></tr></thead><tbody>
{% for t in cell.cell_rows %}
<tr{% if t.evidence_ids %} class="claim" data-evidence="{{ t.evidence_ids | evattr }}"{% endif %}><td><strong>{{ t.gene }}</strong></td>
<td>{{ t.top_label }} <span class="small">({{ t.top_group }})</span></td><td class="num">{{ t.top_pct }}</td><td class="num">{{ t.top_share }}</td>
<td class="num">{{ t.neutrophil_share | fmt }}</td><td class="num">{{ t.tau | fmt }}</td>
<td class="num">{% if t.retained is not none %}{{ "%.0f" | format(100 * t.retained) }} % <span class="small">({{ t.verdict | replace("_"," ") }})</span>{% else %}—{% endif %}</td>
<td class="num">{% if t.ivh %}log2FC {{ t.ivh.log2fc }} (padj {{ t.ivh.padj }}, {{ t.ivh.cluster }}){% else %}—{% endif %}</td><td>{{ t.evidence_ids[:4] | cite | safe }}</td></tr>
{% endfor %}</tbody></table></div>

{% if cell.rep4 %}{% set R4 = cell.rep4 %}
<h2>Do the other atlases agree? {{ q('sc_replication') }}</h2>
<p class="lede">The same question across four colon single-cell atlases: Smillie et al. 2019, Garrido-Trigo et al. 2023, Gubatan et al. 2026 and the anti-TNF atlas of Thomas et al. 2024 (GSE282122). For the fourth, GEO holds the count matrices without cell labels, so its {{ "{:,}".format(R4.sc4.cells_typed) }} cells ({{ R4.sc4.uc_samples }} UC biopsies before and after adalimumab and {{ R4.sc4.healthy_samples }} healthy ones, colon only) were typed here into lineages from canonical markers (k-means on a marker panel, {{ R4.sc4.clusters }} clusters). All atlases are folded into five shared lineages: epithelial, stromal (with endothelium), T and NK, plasma, myeloid (with mast cells, and neutrophils where an atlas has them: only Gubatan 2026); B cells are left out. Neutrophil genes therefore cannot agree in the three atlases without neutrophils. For {{ R4.summary.genes }} genes, the Smillie lineage is also dominant in {% for k, v in R4.summary.agree_with_smillie.items() %}{{ v.agree }} of {{ v.measured }} in {{ R4.summary.atlases[k] }}{% if not loop.last %}, {% endif %}{% endfor %}. It is dominant in all three other atlases for {{ R4.summary.agree_count["3"] }} genes, in two for {{ R4.summary.agree_count["2"] }}, in one for {{ R4.summary.agree_count["1"] }} and in none for {{ R4.summary.agree_count["0"] }}. The cell-source light of the shortlist is green only when the lineage is dominant in at least two of the three other atlases.</p>
{{ plot('sc_replication', figs.sc_replication) }}
<div class="tw"><table><thead><tr><th>Gene</th><th>Smillie 2019</th><th>Garrido-Trigo 2023</th><th>Gubatan 2026</th><th>GSE282122</th><th class="num">Other atlases agreeing</th><th>Evidence</th></tr></thead><tbody>
{% for r in R4.rows %}<tr class="claim" data-evidence="{{ r.evidence_ids | evattr }}"><td><strong>{{ r.gene }}</strong>{% if r.shortlist %} <span class="small">(shortlist)</span>{% endif %}</td>
{% for k in ("smillie", "garrido", "gubatan", "gse282122") %}<td>{{ r[k][0] }} {% if r[k][1] is not none %}<span class="small">{{ "%.0f" | format(100 * r[k][1]) }} %</span>{% endif %}</td>{% endfor %}
<td class="num">{{ r.n_agree }} of 3</td><td>{{ r.evidence_ids | cite | safe }}</td></tr>{% endfor %}
</tbody></table></div>
<p class="small">Typing check for GSE282122: for each lineage, how many of its canonical markers are highest in that lineage: {% for L, v in R4.sc4.typing_check.items() %}{{ L }} {% if v.present %}{{ v.own_top }}/{{ v.markers }}{% else %}absent{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}. Cells per lineage: {% for L, n in R4.sc4.cells_by_lineage.items() %}{{ L }} {{ "{:,}".format(n) }}{% if not loop.last %}, {% endif %}{% endfor %}. {% if not R4.sc4.typing_check.neutrophil.present %}No neutrophil cluster emerged: neutrophils carry little RNA and are mostly lost in standard droplet filtering, so in this atlas neutrophil genes fall to the other myeloid cells or are missed. {% endif %}{{ "{:,}".format(R4.sc4.cells_mixed) }} cells in clusters without a clear lineage (low signal or likely doublets) were left out.</p>
{% endif %}
<h2>Where in the tissue, and what is next to it?</h2>
{% set V = cell.visium %}
<p class="lede">The tissue data are {{ "{:,}".format(V.spots) }} Visium spots from {{ V.sections }} colon sections (GSE189184; {{ "{:,}".format(V.uc_spots) }} spots in seven inflamed UC sections, the rest in two healthy ones). Each 55 µm spot mixes several cells, so its cell make-up is estimated by fitting it to the single-cell profiles of twelve cell groups (non-negative least squares on marker genes). The candidate genes were left out of that fit, which makes them a fair test of it: {% for g, v in V.validation_held_out.items() %}{{ g }} follows the {{ v.group | replace("_", " ") | lower }} share (rho {{ v.spearman }}){% if not loop.last %}, {% endif %}{% endfor %}. The correlations are positive but modest for low-count genes. Neutrophils make up {{ "%.1f" | format(100 * V.mean_share_uc.Neutrophil) }} % of the estimated transcripts in UC spots against {{ "%.1f" | format(100 * V.mean_share_healthy.Neutrophil) }} % in healthy ones, and the epithelium {{ "%.0f" | format(100 * V.mean_share_uc.Epithelial) }} % against {{ "%.0f" | format(100 * V.mean_share_healthy.Epithelial) }} %. The Tissue viewer tab shows the same data on the real H&amp;E sections.</p>
{{ paras(f.narrative.sections.spatial or []) }}
<p class="small">Use the menu above each map to pick a cell share or a candidate gene. These are the largest UC resection and a healthy biopsy.</p>
<div class="grid two">
  {{ plot('visium_maps', figs.map_uc) }}
  {{ plot('visium_maps', figs.map_healthy) }}
</div>
<div class="grid two">
  {{ plot('expressers', figs.expressers) }}
  {{ plot('neighbors', figs.neighbors) }}
</div>
<p class="small">For each gene, we take the top tenth of spots in each UC section and look at the ring of six spots around each one (about 100 micrometres). We compare the cell make-up of those rings with rings around random spots of the same sections, as a ratio, so common cell types get no head start. A permutation test with 1,000 shuffles gives each p-value, adjusted over all genes and cell groups. The shuffle picks spots one by one, while spots of one tissue zone lie together, so these p-values are too small (about half of all gene and cell-group pairs pass). Read the size of the enrichment, not the p-value.</p>
<h3>Tissue context of each candidate {{ q('spatial_table') }}</h3>
<div class="tw"><table>
<thead><tr><th>Gene</th><th>In-situ expresser (NNLS)</th><th>Share of in-situ signal</th><th>Composition-corrected source</th><th>Compartment it follows (marker co-variation)</th><th>High spots</th><th>Enriched neighbours (log₂ obs/exp, padj &lt; 0.05)</th><th>Evidence</th></tr></thead><tbody>
{% for t in cell.spatial_rows %}
<tr{% if t.evidence_ids %} class="claim" data-evidence="{{ t.evidence_ids | evattr }}"{% endif %}><td><strong>{{ t.gene }}</strong></td><td>{{ t.top_expresser | fmt }}</td><td class="num">{{ t.contribution | fmt }}</td><td>{{ t.corrected | fmt }}</td>
<td>{{ t.compartment | fmt }}</td><td class="num">{{ t.n_high }}</td>
<td>{% for e in t.neighbors %}{{ e.cell_group | replace("_"," ") }} {{ "%+.2f"|format(e.log2_enrichment) }}{% if not loop.last %} · {% endif %}{% endfor %}{% if not t.neighbors %}—{% endif %}</td>
<td>{{ t.evidence_ids[:4] | cite | safe }}</td></tr>
{% endfor %}</tbody></table></div>
<h3>Single-cell resolution in situ (Xenium 5K) {{ q('xenium_table') }}</h3>
<p class="small">Xenium sections: {% for s in cell.xenium_sections %}{{ s.state }} {{ s.gsm }}{% if s.study %} ({{ s.study }}{% endif %}, {{ "{:,}".format(s.cells) }} cells{% if s.median_counts_per_cell is defined %}, median {{ "%.0f" | format(s.median_counts_per_cell) }} transcripts per cell{% endif %}, {{ "%.0f" | format(100 * s.assigned_fraction) }} % typed){{ "; " if not loop.last }}{% endfor %}. Sections with fewer than half the cells typed are left out. Many candidates are not on the 5,000-gene panel; Visium covers them.</p>
