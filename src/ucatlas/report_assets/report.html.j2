  var cy=null, cyData={{ network_json | safe }};
  function css(v){return getComputedStyle(root).getPropertyValue(v).trim();}
  function resizePlots(p){[].slice.call(p.querySelectorAll('.js-plotly-plot')).forEach(function(d){try{Plotly.Plots.resize(d);}catch(e){}});}
  function initCy(){
    if(cy||!document.getElementById('cy')) return;
    cy=cytoscape({container:document.getElementById('cy'),elements:cyData.nodes.concat(cyData.edges),
      layout:{name:'cose',animate:false,nodeRepulsion:9000,idealEdgeLength:90},
      style:[
        {selector:'node',style:{'label':'data(label)','font-size':10,'color':css('--ink'),'text-valign':'bottom','text-margin-y':3}},
        {selector:'node[kind="gene"]',style:{'background-color':css('--s1'),'width':18,'height':18}},
        {selector:'node[kind="drug"]',style:{'background-color':css('--s3'),'shape':'diamond','width':12,'height':12,'font-size':8}},
        {selector:'node[kind="disease"]',style:{'background-color':css('--s4'),'shape':'round-rectangle','width':34,'height':20,'font-size':12,'font-weight':'bold'}},
        {selector:'edge',style:{'width':1.2,'line-color':'#9aa0aa','curve-style':'bezier','opacity':0.7}},
        {selector:'edge[kind="drug"]',style:{'line-color':css('--s3'),'target-arrow-shape':'triangle','target-arrow-color':css('--s3')}},
        {selector:'edge[kind="upregulated_in"]',style:{'line-color':css('--s8'),'line-style':'dashed'}},
        {selector:'edge[kind="downregulated_in"]',style:{'line-color':css('--s1'),'line-style':'dashed'}}]});
    cy.on('tap','edge',function(evt){var d=evt.target.data();
      document.getElementById('cy-info').textContent=d.kind+': '+cy.getElementById(d.source).data('label')+' → '+cy.getElementById(d.target).data('label')+' · evidence '+d.ev;});
  }
  function show(name,push){
    var p=document.getElementById('tab-'+name)||document.getElementById('tab-overview'); name=p.getAttribute('data-name');
    panels.forEach(function(x){x.classList.toggle('on',x===p);});
    tabs.forEach(function(t){t.setAttribute('aria-selected',t.getAttribute('data-tab')===name?'true':'false');});
    var cur=tabs.filter(function(t){return t.getAttribute('data-tab')===name;})[0], cr=document.getElementById('navcrumb');
    if(cur&&cr){cr.innerHTML=''; var c=document.createElement('span'), b=document.createElement('b'); c.className='cat'; c.textContent=cur.getAttribute('data-cat')+' › ';
      b.textContent=cur.firstChild.textContent; cr.appendChild(c); cr.appendChild(b);}
    closeMenu();
    if(name==='network'){initCy(); if(cy){cy.resize();cy.fit(undefined,30);}}
    resizePlots(p); if(name==='viewer'&&window.viewerShow) window.viewerShow();
    if(push!==false){try{history.replaceState(null,'','#tab='+name);}catch(e){}}
  }
  tabs.forEach(function(t){t.addEventListener('click',function(){show(t.getAttribute('data-tab'));window.scrollTo(0,0);});});
  var nb=document.getElementById('navbtn'), nm=document.getElementById('navmenu');
  function closeMenu(){if(nm&&!nm.hidden){nm.hidden=true; nb.setAttribute('aria-expanded','false');}}
  if(nb){nb.addEventListener('click',function(e){e.stopPropagation(); var open=nm.hidden; nm.hidden=!open; nb.setAttribute('aria-expanded',open?'true':'false');
    if(open){var sel=nm.querySelector('.tab[aria-selected="true"]')||nm.querySelector('.tab'); if(sel) sel.focus();}});}
  document.addEventListener('click',function(e){if(nm&&!nm.hidden&&!e.target.closest('#navmenu,#navbtn')) closeMenu();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&nm&&!nm.hidden){closeMenu(); nb.focus();}});
  function step(d){var i=tabs.map(function(t){return t.getAttribute('aria-selected');}).indexOf('true');
    var t=tabs[(i+d+tabs.length)%tabs.length]; show(t.getAttribute('data-tab')); window.scrollTo(0,0);}
  document.getElementById('navprev').addEventListener('click',function(){step(-1);});
  document.getElementById('navnext').addEventListener('click',function(){step(1);});
  document.addEventListener('click',function(e){
    var a=e.target.closest('a[href^="#"]'); if(!a) return;
    var id=a.getAttribute('href').slice(1); if(!id||id.indexOf('tab=')===0) return;
    var el=document.getElementById(id); if(!el) return; e.preventDefault();
    var p=el.closest('.panel'); if(p) show(p.getAttribute('data-name'),false);
    el.scrollIntoView({behavior:'smooth',block:'center'});
    try{history.replaceState(null,'','#'+id);}catch(x){}
  });
  document.addEventListener('click',function(e){
    var b=e.target.closest('button.q'); if(!b) return;
    var host=b.closest('.plot,.kpi,.card,h2,h3'); if(!host) return;
    var open=b.getAttribute('aria-expanded')==='true', box=host._help;
    if(open){b.setAttribute('aria-expanded','false'); if(box) box.hidden=true; return;}
    if(!box){box=document.createElement('div'); box.className='helpbox';
      function esc(t){var d=document.createElement('div'); d.textContent=t; return d.innerHTML;}
      box.innerHTML='<p><b>What it shows.</b> '+esc(b.dataset.what)+'</p><p><b>How to read it.</b> '+esc(b.dataset.read)+'</p><p><b>Keep in mind.</b> '+esc(b.dataset.watch)+'</p>';
      if(host.matches('h2,h3')) host.insertAdjacentElement('afterend',box);
      else if(host.classList.contains('plot')) host.insertBefore(box,host.children[1]);
      else host.appendChild(box);
      host._help=box;}
    box.hidden=false; b.setAttribute('aria-expanded','true');
  });
  var rows=[].slice.call(document.querySelectorAll('#dtable tbody tr')), ft='all', fs='', q='';
  function filt(){
    var n=0;
    rows.forEach(function(r){
      var okT=ft==='all'||r.dataset.track===ft;
      var st=r.dataset.status, okS=!fs||(fs==='novel'?(st.indexOf('novel')===0||st==='first-in-class opportunity'):st===fs);
      var okQ=!q||r.dataset.text.indexOf(q)>=0, vis=okT&&okS&&okQ; r.style.display=vis?'':'none'; if(vis)n++;});
    var c=document.getElementById('dcount'); if(c) c.textContent=n+' of '+rows.length+' shown';
  }
  [].slice.call(document.querySelectorAll('[data-ftrack]')).forEach(function(b){b.addEventListener('click',function(){
    ft=b.dataset.ftrack; [].slice.call(document.querySelectorAll('[data-ftrack]')).forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');}); filt();});});
  [].slice.call(document.querySelectorAll('[data-fstatus]')).forEach(function(b){b.addEventListener('click',function(){
    var on=b.getAttribute('aria-pressed')==='true'; [].slice.call(document.querySelectorAll('[data-fstatus]')).forEach(function(x){x.setAttribute('aria-pressed','false');});
    fs=on?'':b.dataset.fstatus; if(!on) b.setAttribute('aria-pressed','true'); filt();});});
  var ds=document.getElementById('dsearch'); if(ds) ds.addEventListener('input',function(){q=ds.value.trim().toLowerCase();filt();});
  filt();
  var ev=[].slice.call(document.querySelectorAll('#evlist .ev')), es=document.getElementById('esearch');
  function efilt(){var s=es.value.trim().toLowerCase(),n=0; ev.forEach(function(e){var v=!s||e.textContent.toLowerCase().indexOf(s)>=0; e.style.display=v?'':'none'; if(v)n++;});
    document.getElementById('ecount').textContent=n+' of '+ev.length+' shown';}
  if(es){es.addEventListener('input',efilt);efilt();}
  var h=(location.hash||'').replace('#tab=','').replace('#','');
  var he=h?document.getElementById(h):null;
  var start=document.getElementById('tab-'+h)?h:(he&&he.closest('.panel')?he.closest('.panel').getAttribute('data-name'):'overview');
  window.addEventListener('hashchange',function(){var h2=(location.hash||'').replace('#tab=','').replace('#','');
    if(document.getElementById('tab-'+h2)) show(h2,false);});
  show(start,false); window.addEventListener('load',function(){resizePlots(document.querySelector('.panel.on'));});
})();
</script>
</body>
</html>
