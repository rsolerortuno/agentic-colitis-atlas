<tr><td>Candidates in the data-only target / biomarker top 500</td><td>{% for x in cb.share_in_data_top500 %}{{ (x * 100) | round(0) | int }} %{% if not loop.last %}, {% endif %}{% endfor %}</td><td>{% for x in pl.share_in_data_top500 %}{{ (x * 100) | round(0) | int }} %{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
<tr><td>Statements citing checkable evidence</td><td>0</td><td>{{ pl.statements_checked | join(", ") }} checked, {{ pl.unsupported | sum }} unsupported</td></tr>
</tbody></table></div>
<p class="small">Closed-book candidates: {% for c in cb.lists %}{{ c | join(", ") }}{% if not loop.last %}; {% endif %}{% endfor %}.
Pipeline targets: {% for c in pl.lists %}{{ c | join(", ") }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
<h3>Orchestrator decisions vs the numeric convergence rank {{ q('agents_table') }}</h3>
<div class="tw"><table><thead><tr><th>Gene</th><th>Decision</th><th>Agent position</th><th>Convergence rank</th><th>Meta log2FC</th><th>Change kept</th><th>Plasma MR q</th><th>Target score</th><th>Biomarker score</th></tr></thead><tbody>
{% for r in agents_vs_ranking %}<tr><td><strong>{{ r.gene }}</strong></td><td>{{ r.category }}</td><td class="num">{{ r.position }}</td><td class="num">{{ r.rank | fmt }}</td>
<td class="num">{{ r.log2fc | fmt }}</td><td class="num">{{ r.retained | fmt }}</td><td class="num">{{ r.mr_q | fmt }}</td><td class="num">{{ r.target | fmt }}</td><td class="num">{{ r.biomarker | fmt }}</td></tr>{% endfor %}
</tbody></table></div>
